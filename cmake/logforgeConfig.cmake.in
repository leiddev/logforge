@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@LOGFORGE_BUILD_SPDLOG@)
    # logforge::spdlog is a static library, so its usage requirements name
    # spdlog::spdlog.  A consumer that links it needs that target in scope before
    # logforgeTargets.cmake is included, which is what find_dependency is for.
    find_dependency(spdlog CONFIG)
endif()

# logforge::core has no dependencies of its own.

include("${CMAKE_CURRENT_LIST_DIR}/logforgeTargets.cmake")

check_required_components(logforge)
